rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return userExists() && 
        (getUserData().get('role', '') == 'admin' || getUserData().get('isAdmin', false) == true);
    }

    function isRestaurantOwner(restaurantId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
         get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.get('ownerId', '') == request.auth.uid) ||
        isAdmin()
      );
    }

    function isRestaurantStaff(restaurantId) {
      return isAuthenticated() && (
        (userExists() &&
         getUserData().get('role', '') == 'restaurant_staff' &&
         getUserData().get('kitchenStaff', {}).get('assignedRestaurantId', '') == restaurantId) ||
        (exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
         request.auth.uid in get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.get('staffIds', []))
      );
    }

    function isRestaurantAuthorized(restaurantId) {
      return isRestaurantOwner(restaurantId) || isRestaurantStaff(restaurantId) || isAdmin();
    }

    // Order state machine helper
    function isValidOrderTransition(oldStatus, newStatus) {
      return oldStatus == newStatus ||
        (oldStatus == 'cart' && newStatus in ['checkout', 'payment_pending', 'cancelled']) ||
        (oldStatus == 'checkout' && newStatus in ['payment_pending', 'cancelled']) ||
        (oldStatus == 'payment_pending' && newStatus in ['paid', 'payment_failed', 'cancelled']) ||
        (oldStatus == 'paid' && newStatus in ['restaurant_pending', 'accepted', 'rejected', 'cancelled']) ||
        (oldStatus == 'restaurant_pending' && newStatus in ['accepted', 'rejected', 'cancelled']) ||
        (oldStatus == 'accepted' && newStatus in ['preparing', 'cancelled']) ||
        (oldStatus == 'preparing' && newStatus in ['ready', 'cancelled']) ||
        (oldStatus == 'ready' && newStatus in ['out_for_delivery', 'delivered', 'cancelled']) ||
        (oldStatus == 'out_for_delivery' && newStatus in ['delivered', 'cancelled']) ||
        (oldStatus == 'delivered' && newStatus in ['refunded']) ||
        (oldStatus == 'payment_failed' && newStatus in ['payment_pending', 'cancelled']) ||
        (oldStatus == 'rejected' && newStatus in ['refunded']) ||
        (oldStatus == 'cancelled' && newStatus in ['refunded']) ||
        (oldStatus == 'confirmed' && newStatus in ['preparing', 'out_for_delivery', 'delivered']) ||
        (oldStatus == 'on_the_way' && newStatus == 'delivered');
    }

    function isNonNegativeNumber(v) {
      return (v is int || v is float) && v >= 0;
    }

    // Fields a client may set when creating an order draft. Server-only fields (serverPriced, paidAt, paymentVerifiedBy,
    // statusHistory, courierId) are deliberately absent.
    function orderCreateFields() {
      return ['id', 'orderNumber', 'userId', 'customerName', 'customerPhone', 'items', 'restaurantId', 'restaurantName',
        'fulfillmentMethod', 'deliveryAddress', 'subtotal', 'deliveryFee', 'serviceFee', 'total', 'currency', 'status',
        'paymentStatus', 'paymentReference', 'paymentMethod', 'createdAt', 'updatedAt', 'estimatedDeliveryTime', 'tapCount',
        'driverName', 'driverPhone', 'driverVehicle', 'courierMessages'];
    }

    function isValidRating(r) {
      return r is map && r.keys().hasOnly(['foodRating', 'restaurantRating', 'deliveryRating', 'feedbackTags', 'timestamp']) &&
        r.foodRating is int && r.foodRating >= 1 && r.foodRating <= 5 &&
        r.restaurantRating is int && r.restaurantRating >= 1 && r.restaurantRating <= 5 &&
        r.deliveryRating is int && r.deliveryRating >= 1 && r.deliveryRating <= 5;
    }

    function isCourierUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('role', '') == 'courier';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || 
        request.resource.data.role == 'customer' || 
        isAdmin()
      ) && (
        !('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false || isAdmin()
      );

      allow update: if (isOwner(userId) && (
        // Ensure user cannot self-promote to admin or change role/verification
        (!('role' in request.resource.data) || request.resource.data.get('role', '') == resource.data.get('role', '')) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)) &&
        (!('verified' in request.resource.data) || request.resource.data.get('verified', false) == resource.data.get('verified', false)) &&
        // A staff member may not re-point themselves at another restaurant (assignment is admin-granted via role requests)
        request.resource.data.get('kitchenStaff', {}).get('assignedRestaurantId', '') ==
          resource.data.get('kitchenStaff', {}).get('assignedRestaurantId', '')
      )) || isAdmin();

      allow delete: if isAdmin();
    }

    // --- Restaurants Collection ---
    match /restaurants/{restaurantId} {
      // Public read for marketplace display
      allow read: if true;

      // Creation: the owner may only create an UNVERIFIED, pending listing. Only admins can create verified restaurants.
      // (Verification is granted by an admin via update; the placeOrder function refuses unverified restaurants.)
      allow create: if isAuthenticated() && (
        (
          request.resource.data.get('ownerId', '') == request.auth.uid &&
          request.resource.data.get('verified', false) == false &&
          request.resource.data.get('verificationStatus', '') == 'pending'
        ) || isAdmin()
      );

      // Update: only the restaurant owner or admin can update; ownership transfer/ownerId change is strictly forbidden,
      // and owners cannot verify themselves.
      allow update: if isAuthenticated() && (
        (
          resource.data.get('ownerId', '') == request.auth.uid &&
          (!('ownerId' in request.resource.data) || request.resource.data.ownerId == resource.data.get('ownerId', '')) &&
          request.resource.data.get('verified', false) == resource.data.get('verified', false) &&
          request.resource.data.get('verificationStatus', '') == resource.data.get('verificationStatus', '')
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // --- Meals Collection ---
    match /meals/{mealId} {
      // Public read for marketplace display
      allow read: if true;

      // Only authorized restaurant owner/staff or admin can create meals for their restaurant
      allow create: if isAuthenticated() && (
        isRestaurantAuthorized(request.resource.data.restaurantId) || isAdmin()
      );

      // Only authorized restaurant owner/staff or admin can update, AND restaurantId cannot be transferred
      allow update: if isAuthenticated() && (
        (
          isRestaurantAuthorized(resource.data.restaurantId) &&
          (!('restaurantId' in request.resource.data) || request.resource.data.restaurantId == resource.data.restaurantId)
        ) || 
        isAdmin()
      );

      // Only authorized restaurant owner/staff or admin can delete meals
      allow delete: if isAuthenticated() && (
        isRestaurantAuthorized(resource.data.restaurantId) || isAdmin()
      );
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      // Single document fetch
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isRestaurantAuthorized(resource.data.restaurantId) ||
        (resource.data.get('courierId', '') != '' && resource.data.get('courierId', '') == request.auth.uid) ||
        isAdmin()
      );

      // Collection list queries
      allow list: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid) ||
        (resource.data.get('courierId', '') != '' && resource.data.get('courierId', '') == request.auth.uid) ||
        (resource.data.restaurantId != null && isRestaurantAuthorized(resource.data.restaurantId)) ||
        isAdmin()
      );

      // Create: a customer may create only their own DRAFT order in an initial state.
      // Rules can only check *shape* (field allowlist, types, non-negative numbers, initial status). They cannot
      // re-price an order: authoritative pricing is done by the `placeOrder` Cloud Function (Admin SDK), which is the
      // only writer of `serverPriced`, and the payment webhook refuses to pay orders that are not `serverPriced`.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly(orderCreateFields()) &&
        request.resource.data.keys().hasAll(['userId', 'restaurantId', 'items', 'status', 'paymentStatus', 'total']) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50 &&
        request.resource.data.restaurantId is string &&
        request.resource.data.restaurantId.size() > 0 &&
        isNonNegativeNumber(request.resource.data.get('subtotal', 0)) &&
        isNonNegativeNumber(request.resource.data.get('deliveryFee', 0)) &&
        isNonNegativeNumber(request.resource.data.get('serviceFee', 0)) &&
        isNonNegativeNumber(request.resource.data.total) &&
        (request.resource.data.status in ['cart', 'checkout', 'payment_pending']) &&
        (request.resource.data.paymentStatus in ['pending', 'unpaid']) &&
        !('courierId' in request.resource.data);

      // Update: Role-based field allowlists and State Machine transitions
      allow update: if isAuthenticated() &&
        // General state machine transition validity check
        isValidOrderTransition(resource.data.status, request.resource.data.status) &&
        (
          // 1. Customer: Can only update specific fields (status to allowed states, rating, courierMessages, tapCount, updatedAt)
          (resource.data.userId == request.auth.uid &&
            request.resource.data.status in ['checkout', 'payment_pending', 'cancelled', resource.data.status] &&
            // customers may cancel only before the kitchen has accepted (afterwards: restaurant/admin/refund flow)
            (request.resource.data.status != 'cancelled' || resource.data.status in
              ['cart', 'checkout', 'payment_pending', 'payment_failed', 'paid', 'restaurant_pending', 'cancelled']) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'ratingSubmitted', 'courierMessages', 'tapCount', 'updatedAt'
            ]) &&
            // rating: only once, only after delivery, and only 1-5 star values
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratingSubmitted']) || (
              resource.data.status == 'delivered' && !('ratingSubmitted' in resource.data) &&
              isValidRating(request.resource.data.ratingSubmitted)
            ))
          ) ||
          // 2. Restaurant Owner / Authorized Staff: Can only update status to restaurant stages, prep ETA, courier assignment, messages, updatedAt
          (isRestaurantAuthorized(resource.data.restaurantId) &&
            request.resource.data.status in ['accepted', 'preparing', 'ready', 'rejected', 'cancelled', resource.data.status] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'estimatedDeliveryTime', 'courierMessages', 'updatedAt', 'courierId'
            ]) &&
            // a courier may only be assigned if that uid really has the courier role
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['courierId']) ||
              isCourierUser(request.resource.data.courierId))
          ) ||
          // 3. Assigned Courier: Can only update delivery status, deliveredAt, driver info, messages, updatedAt
          (resource.data.get('courierId', '') != '' && resource.data.get('courierId', '') == request.auth.uid &&
            request.resource.data.status in ['out_for_delivery', 'delivered', resource.data.status] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'deliveredAt', 'driverName', 'driverPhone', 'driverVehicle', 'courierMessages', 'updatedAt'
            ])
          ) ||
          // 4. Admin / Trusted Backend system override
          isAdmin()
        );

      allow delete: if isAdmin();
    }

    // --- Recommendation Events Collection ---
    match /recommendation_events/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Analytics events: own userId only, strict field allowlist, enum event type and bounded string/number sizes.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['userId', 'mealId', 'restaurantId', 'eventType', 'rejectionReason', 'position', 'timestamp', 'locationContext']) &&
        request.resource.data.keys().hasAll(['userId', 'eventType', 'timestamp']) &&
        request.resource.data.eventType in ['impression', 'meal_opened', 'selected', 'clicked', 'rejected', 'added_to_cart',
          'meal_added', 'ordered', 'meal_ordered', 'rated', 'meal_rated'] &&
        request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 40 &&
        (!('mealId' in request.resource.data) || (request.resource.data.mealId is string && request.resource.data.mealId.size() <= 128)) &&
        (!('restaurantId' in request.resource.data) || (request.resource.data.restaurantId is string && request.resource.data.restaurantId.size() <= 128)) &&
        (!('rejectionReason' in request.resource.data) || (request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.size() <= 64)) &&
        (!('locationContext' in request.resource.data) || (request.resource.data.locationContext is string && request.resource.data.locationContext.size() <= 120)) &&
        (!('position' in request.resource.data) || (request.resource.data.position is int && request.resource.data.position >= 0 && request.resource.data.position <= 100));

      allow update, delete: if isAdmin();
    }

    // --- Role Requests Collection ---
    // Users cannot promote themselves. They file a request (document id `${uid}_${role}`); an admin approves it,
    // which updates users/{uid}.role (+ staff assignment) and marks the request approved.
    match /roleRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['userId', 'requestedRole', 'restaurantId', 'note', 'status', 'createdAt']) &&
        request.resource.data.keys().hasAll(['userId', 'requestedRole', 'status', 'createdAt']) &&
        request.resource.data.requestedRole in ['restaurant_staff', 'courier'] &&
        request.resource.data.status == 'pending' &&
        requestId == request.auth.uid + '_' + request.resource.data.requestedRole &&
        (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500)) &&
        (!('restaurantId' in request.resource.data) || (request.resource.data.restaurantId is string && request.resource.data.restaurantId.size() <= 128));

      // Admin reviews; a requester may withdraw their own request only after it was rejected (so they can re-apply).
      allow update: if isAdmin();
      allow delete: if isAdmin() || (resource.data.userId == request.auth.uid && resource.data.status == 'rejected');
    }
  }
}
