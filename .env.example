# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- African Dish (client, Vite) ---
# Talk to local Auth + Functions emulators (firebase emulators:start --only auth,functions,firestore)
# VITE_USE_FIREBASE_EMULATORS=true
# DEV ONLY: use the emulator-only simulatePayment function instead of Paystack. Ignored in production builds.
# VITE_ENABLE_PAYMENT_SIMULATION=true

# --- Cloud Functions (server) ---
# Set as a secret in production: firebase functions:secrets:set PAYSTACK_SECRET_KEY
# For local emulator runs put it in functions/.env.local (git-ignored).
# PAYSTACK_SECRET_KEY=sk_test_xxx
# NEVER set in production:
# ALLOW_PAYMENT_SIMULATION=true
